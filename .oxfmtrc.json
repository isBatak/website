{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "endOfLine": "lf",
  "useTabs": false,
  "arrowParens": "always",
  "quoteProps": "as-needed",
  "bracketSpacing": true,
  "singleQuote": true,
  "semi": true,
  "trailingComma": "es5",
  "sortPackageJson": false,
  "ignorePatterns": ["next-env.d.ts"]
}
